{
  "name": "browser-session-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "复用浏览器会话的本地 MCP 自动化服务与扩展。",
  "type": "commonjs",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node mcp-server/index.js",
    "server": "node mcp-server/index.js",
    "doctor": "node mcp-server/index.js --doctor",
    "test": "node mcp-server/tests/server.test.js && node mcp-server/tests/bridge.test.js && node mcp-server/tests/disconnect.test.js && node mcp-server/tests/connections.test.js && node mcp-server/tests/extension-transport.test.js && node --test mcp-server/tests/doctor.test.js tools/tests/packaging.test.js",
    "test:server": "node mcp-server/tests/server.test.js",
    "test:bridge": "node mcp-server/tests/bridge.test.js",
    "test:transport": "node mcp-server/tests/extension-transport.test.js",
    "test:connections": "node mcp-server/tests/connections.test.js",
    "test:doctor": "node --test mcp-server/tests/doctor.test.js",
    "test:live": "node mcp-server/tests/live-smoke.js",
    "install:host": "node native-messaging-host/install.js",
    "install:native-host": "node native-messaging-host/install.js",
    "package:store": "node tools/package-extension.js",
    "package:source": "node tools/package-source.js",
    "lint:firefox": "npx --yes web-ext lint --source-dir browser-extension"
  },
  "license": "MIT"
}
