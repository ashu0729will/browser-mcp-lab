{
  "name": "browser-session-mcp",
  "version": "0.3.3",
  "private": true,
  "description": "复用真实浏览器会话的本地自动化闭环：MV3 扩展、零依赖 MCP 服务器和原生消息桥。",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node mcp-server/index.js",
    "server": "node mcp-server/index.js",
    "test": "node mcp-server/tests/server.test.js && node mcp-server/tests/bridge.test.js && node mcp-server/tests/disconnect.test.js && node mcp-server/tests/extension-transport.test.js",
    "test:server": "node mcp-server/tests/server.test.js",
    "test:bridge": "node mcp-server/tests/bridge.test.js",
    "test:transport": "node mcp-server/tests/extension-transport.test.js",
    "install:host": "node native-messaging-host/install.js",
    "install:host": "node native-messaging-host/install.js",
    "install:native-host": "node native-messaging-host/install.js",
    "package:store": "node tools/package-extension.js",
    "lint:firefox": "npx --yes web-ext lint --source-dir browser-extension"
  },
  "license": "MIT"
}
