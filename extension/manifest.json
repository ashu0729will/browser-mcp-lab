{
  "manifest_version": 3,
  "name": "Browser MCP Lab",
  "version": "0.3.2",
  "description": "Let AI agents drive your real browser tab. Pairs with the browser-mcp-lab local server (ws://127.0.0.1:9777). Works in Chrome, Edge and Firefox.",
  "author": "ashu0729will",
  "permissions": ["tabs", "scripting", "storage", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "service-worker.js",
    "scripts": ["service-worker.js"]
  },
  "action": {
    "default_title": "Browser MCP Lab",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-mcp-lab@ashu0729will.local",
      "strict_min_version": "128.0"
    }
  }
}
